# --- сервер (docker-compose.prod.yml) ---
# домен сайта без https://, например dragon-club.ru; пока домена нет - :80
SITE_ADDRESS=:80
# пароль базы: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# --- для разработки (docker-compose.yml); на сервере DATABASE_URL собирается из POSTGRES_PASSWORD ---
DATABASE_URL=postgresql+asyncpg://kki:kki@db:5432/kki
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080
TELEGRAM_BOT_TOKEN=
# если сервер не достаёт до api.telegram.org (блокировка у хостера): прокси только для бота,
# см. deploy/tgproxy/README.md. Пример: TELEGRAM_PROXY=socks5://tgproxy:1080
TELEGRAM_PROXY=
# VK ID (вход через VK и стена сообщества): ID приложения с id.vk.ru, доверенный redirect URL = PUBLIC_BASE_URL/auth/vk.
# Секретный ключ для VK ID без SDK не нужен. Токены сообществ клубов вводятся на сайте, не здесь.
VK_APP_ID=
VK_APP_SECRET=
AUTO_CREATE_TABLES=true
TELEGRAM_GLOBAL_CHAT_ID=
PUBLIC_BASE_URL=http://localhost:3000
APP_TIMEZONE=Europe/Moscow
TELEGRAM_TRADE_CHAT_ID=
# имя бота без @: виджет входа через Telegram и ссылки на ставки на сайте
NEXT_PUBLIC_TG_BOT_NAME=
SCRYFALL_AUTO_SYNC=true
# --- почта для восстановления пароля (пусто - ссылка пишется в лог: docker compose logs backend) ---
# Яндекс: smtp.yandex.ru, 465, ssl, пароль приложения из id.yandex.ru -> Безопасность
# Mail.ru: smtp.mail.ru, 465, ssl, пароль для внешних приложений
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
